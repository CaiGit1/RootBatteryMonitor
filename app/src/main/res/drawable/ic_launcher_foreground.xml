<?xml version="1.0" encoding="utf-8"?>
<!--
  应用图标前景层：电池轮廓 + 闪电。
  自适应图标规范是 108×108 视口，但真正可见区域只有居中约 66×66（会被系统裁成圆/方圆形），
  因此所有图形都收在 x 26–85、y 34–70 之内，留足安全边距。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 电池外壳（描边） -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="6"
        android:pathData="M34,34 h36 a8,8 0 0 1 8,8 v20 a8,8 0 0 1 -8,8 h-36 a8,8 0 0 1 -8,-8 v-20 a8,8 0 0 1 8,-8 z" />

    <!-- 正极触点 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M78,46 h4 a3,3 0 0 1 3,3 v6 a3,3 0 0 1 -3,3 h-4 z" />

    <!-- 闪电 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M57,38 L45,55 L52,55 L50,68 L62,50 L54,50 Z" />
</vector>
