<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14 (API 34) 起：声明了 foregroundServiceType 就必须同时声明对应的类型权限，
         否则 startForeground() 抛 SecurityException 直接闪退。原工程缺这一条。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13 (API 33) 起通知为运行时权限，前台服务的常驻通知需要它才能显示 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 悬浮窗：在其他应用上层显示电池信息。
         这是特殊权限，需要在系统设置里由用户手动授予（Settings.ACTION_MANAGE_OVERLAY_PERMISSION）。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Android 16 (API 36) 实况通知（Live Updates / 以进度为中心的通知）：
         把常驻通知提升为状态栏与锁屏上的实时活动。
         这是普通权限（非运行时），声明即可；是否真的被提升仍由系统策略与用户开关决定。 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Root Battery Monitor"
        android:supportsRtl="true"
        android:theme="@style/Theme.RootBatteryMonitor">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".BatteryMonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
